# Copy to tests/integration/.env.local (gitignored) and fill in values.
# Requires a running local AgentStudio env (console + Keycloak reachable)

# --- Platform API ---
API_BASE_URL=https://app.agentstudio.local:8443/config

# ===========================================================================
# AGENT_SERVICE — variables for the agent-service E2E suites
# (instantiation, session, memory, orchestration_policy, guardrails,
#  overrides, kb_retrieval, protocol). Suites are skipped if the base URLs
#  below are unset.
# ===========================================================================

# Base URLs of the agent-service (invoke/stream/ws) and config-service
# (project/model/agent/team provisioning). Both are OPTIONAL: when unset they
# are derived from API_BASE_URL (the /config base) — the root (API_BASE_URL
# minus a trailing /config) becomes {root}/agents-maf and {root}/config. Set
# them explicitly only to override the derived values.
# AGENT_SERVICE_URL=https://app.agentstudio.local:8443/agents-maf
# CONFIG_SERVICE_URL=https://app.agentstudio.local:8443/config

# Require a Keycloak bearer token on config-service calls (true/false).
ENABLE_AUTH_CONFIG_SERVICE=true
# Require a Keycloak bearer token on agent-service calls (true/false).
ENABLE_AUTH_AGENT_SERVICE=false
# Keycloak realm issuer URL (used only when an ENABLE_AUTH_* flag is true).
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8081/realms/nemo
# Service-account (client_credentials) client id for the bearer token.
KEYCLOAK_SERVICE_CLIENT_ID=
# Service-account (client_credentials) client secret for the bearer token.
KEYCLOAK_SERVICE_CLIENT_SECRET=
# NOTE: the legacy KEYCLOAK_CLIENT_ID / KEYCLOAK_CLIENT_SECRET names are still
# honored as a fallback for the service account, but prefer the SERVICE_* names
# above so the password-grant client id (below) stays independent.

# Azure OpenAI credential — the instantiation suite creates it before the model
# (config-service requires a credentialId for provider=azure).
# Azure OpenAI API key.
AZURE_OPENAI_API_KEY=
# Azure OpenAI resource endpoint.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# Azure OpenAI API version (defaults to 2024-06-01).
AZURE_OPENAI_API_VERSION=2024-06-01

# Optional model config — the instantiation suite uses a single model. Models
# are created without a credentialId (LLM calls route through Bifrost). Provider
# is one of: openai, openai_compatible, aws_bedrock, azure, google, local.
# AGENT_MODEL_NAME=gpt-4o-mini               # model display name
# AGENT_MODEL_PROVIDER=azure                 # model provider
# AGENT_MODEL_PROVIDER_MODEL_ID=gpt-4o-mini  # provider-side model id
# AGENT_MODEL_TYPE=llm                       # model type
# AGENT_MODEL_CLASS=balanced                 # model class
# Alternate model id used by the overrides suite (model_override test).
# OVERRIDE_MODEL_NAME=

# Optional resource reuse — when set, suites skip creating the resource and do
# NOT delete it in teardown (each is independent).
# Reuse an existing project.
# PROJECT_ID=projdulfc94n
# Reuse an existing model.
# LLM_MODEL_ID=00000000-0000-0000-0000-000000000000
# Reuse an existing Azure OpenAI credential (instantiation suite).
# AZURE_OPENAI_CRED_ID=00000000-0000-0000-0000-000000000000
# Existing knowledge base id (kb_retrieval suite; never created/deleted by tests).
# KB_ID=kbxxxxxxxx
# Existing MCP server id (when a suite needs an MCP server).
# MCP_ID=00000000-0000-0000-0000-000000000000

# --- Keycloak (pytest password grant) ---
# OPTIONAL: when unset, derived from API_BASE_URL (app.<host> -> auth.<host>,
# realm nemo). Set explicitly for localhost or non-app.* hosts.
# KEYCLOAK_TOKEN_URL=https://auth.agentstudio.local:8443/realms/nemo/protocol/openid-connect/token
# Public OAuth client used for the password grant (smoke + KB suites). Distinct
# from the service-account client above. Legacy KEYCLOAK_CLIENT_ID is honored as
# a fallback for this value.
KEYCLOAK_PASSWORD_GRANT_CLIENT_ID=agent-studio-ui
KEYCLOAK_USERNAME=your-user@example.com
KEYCLOAK_PASSWORD=
# Local dev: pytest can enable Direct access grants on agentstudio-gui
# KEYCLOAK_ENABLE_PASSWORD_GRANT=1

CURL_INSECURE=1

# --- Bifrost LLM gateway (remote/catalog/platform MCP tool-invocation checks) ---
# Base URL of Bifrost's raw MCP API. OPTIONAL: when unset, the Bifrost-backed
# tool-invocation checks skip (the config-service-side registration is still
# validated). Bifrost has no app-ingress route, so port-forward it, e.g.:
#   kubectl port-forward -n agentstudio-llm-gateway svc/bifrost-proxy 8082:8080
# LLM_GATEWAY_URL=http://localhost:8082
# Only needed when the gateway enforces auth (local Bifrost is unauthenticated).
# LLM_GATEWAY_API_KEY=

# --- S3-compatible object store (test_s3compatible_pipeline.py) ---
# MinIO, s3gateway, AWS S3, etc. — provider s3 + endpoint in connector_config
# S3_ENDPOINT=https://s3.agentstudio.local:8443
# S3_BUCKET=your-bucket
# S3_PREFIX=integration-smoke/
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# ===========================================================================
# HAPPY-PATH SUITES — projects / members / models / kb
# (suites/projects, suites/models, suites/knowledge_base/test_kb_happy_path.py)
# ===========================================================================

# --- User management (members) suite: suites/projects/test_project_members.py ---
# Target email for the add/change-role/remove member flow. Add is
# resolve-or-create, so it PROVISIONS a Keycloak user — the suite SKIPS when
# this is unset to avoid polluting shared realms. The logged-in user
# (KEYCLOAK_USERNAME) must be admin on the project it creates (granted during
# project-init).
# MEMBER_TEST_EMAIL=e2e-member@example.com

# --- Role enforcement tests (suites/projects/test_project_roles.py) ---
# These auto-provision two throwaway realm users (e2e-role-admin-*/e2e-role-member-*
# @example.com) via the Keycloak Admin API using KEYCLOAK_ADMIN_PASSWORD, and delete
# them in teardown. No secrets required. Optionally override the generated password:
# ROLE_TEST_PASSWORD=Passw0rd!e2e

# --- Gated provider model registration: test_provider_model_registration.py ---
# Reuses the AZURE_OPENAI_* block above (registers provider=azure) when set.
# Otherwise set an OpenAI / OpenAI-compatible key. The suite SKIPS when neither
# is present. The zero-credential platform-hosted-models suite always runs.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # set -> provider=openai_compatible (self-managed)
# MODEL_PROVIDER_MODEL_ID=gpt-4o-mini  # optional: pin the model id to register
# MODEL_INFER=0                        # 1 -> run the live /infer assertion (needs reachable provider + Bifrost VK)

# --- KB happy path: suites/knowledge_base/test_kb_happy_path.py ---
# Reuse an existing READY dataset instead of building one via a connector.
# Requires PROJECT_ID (above) to be the project that owns the dataset. The
# reused project/dataset are NOT deleted; only the created KB is. When unset,
# the KB happy path falls back to the S3_* connector pipeline, or skips.
# KB_SOURCE_DATASET_ID=

# --- Cleanup (default: delete project and child resources after each test) ---
# Used by the knowledge_base suites and the agent_service suites' after-class
# teardown: when 1 (default) every project/model/agent/team/KB created by a
# suite is deleted; set 0 to keep them in the UI for debugging.
INTEGRATION_CLEANUP=1

# --- Search / seed (S3-compatible) ---
# INTEGRATION_SEED_S3=1
# INTEGRATION_SEED_S3=0
# E2E_SEARCH_QUERY=phrase known to exist under S3_PREFIX
# S3COMPATIBLE_E2E_SEARCH_QUERY=   # optional override

# --- PostgreSQL (test_postgres_pipeline.py) ---
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=nemo
# POSTGRES_SCHEMA=public
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=
# POSTGRES_SSL_MODE=prefer
# POSTGRES_SOURCE_TABLE=address
# POSTGRES_SCHEMA=public
# POSTGRES_SQL_QUERY=   # optional — omit to auto-build from DATABASE + SCHEMA + SOURCE_TABLE
# Or one line in .env: POSTGRES_SQL_QUERY=-- Database: pagila\nSELECT * FROM "public"."address"
# POSTGRES_KB_TEXT_COLUMNS=name,description
# POSTGRES_E2E_SEARCH_QUERY=

# --- MySQL (test_mysql_pipeline.py) ---
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=sakila
# MYSQL_SCHEMA=sakila
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=
# MYSQL_SSL_MODE=disable
# MYSQL_SOURCE_TABLE=actor
# MYSQL_SCHEMA=sakila
# MYSQL_SQL_QUERY=-- Database: sakila
# SELECT * FROM sakila.actor
# (optional — if omitted, built as: -- Database: <db> + SELECT * FROM db.table LIMIT 100)
# MYSQL_KB_TEXT_COLUMNS=first_name,last_name
# MYSQL_E2E_SEARCH_QUERY=

# --- Azure / ANF (test_anf_metrics_pipeline.py, test_anf_mcp_server.py) ---
# Service principal with Reader on subscription/ANF resources (metrics + MCP read tools).
# Resize tests additionally require capacityPools/write and volumes/write RBAC.
# AZURE_SUBSCRIPTION_ID=
# AZURE_DEFAULT_REGION=eastus
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_RESOURCE_GROUP=   # optional filter for metrics queries and MCP list ops
# ANF_TEST_POOL_ARM_ID=     # full ARM id for a test capacity pool (MCP read/resize tests)
# ANF_TEST_VOLUME_ARM_ID= # full ARM id for a test volume (MCP read/resize tests)
# Comma-separated: volume_metrics, pool_metrics, volume_tier_metrics
# ANF_METRIC_CATEGORIES=volume_metrics,pool_metrics,volume_tier_metrics
# ANF_ACQUISITION_TIMEOUT_SEC=900
# ANF_MCP_PROVISION_TIMEOUT_SEC=900
# ANF_MCP_ALLOW_WRITE=0   # set 1 to enable grow-only resize tool tests (local only)

# --- GCP metrics (test_gcp_metrics_pipeline.py) ---
# GCP_PROJECT_ID=agent-studio-netapp
# GCP_DEFAULT_REGION=us-east4
# GCP_SERVICE_ACCOUNT_JSON_FILE=./gcp-service-account.json

# --- ONTAP metrics (test_ontap_metrics_pipeline.py) ---
# ONTAP_CLUSTER_URL=https://cluster.example.com
# ONTAP_VERIFY_TLS=true
# ONTAP_DEFAULT_SVM=
# ONTAP_USERNAME=
# ONTAP_PASSWORD=

# --- Manual unstructured upload (test_dataset_manual_unstructured.py) ---
# Optional. When unset, the test uploads a small built-in text file.
# Local: absolute path or path relative to tests/integration/.
# CI container: use a path under /work/ (baked into the integration-test image).
# MANUAL_UPLOAD_FILE_PATH=/Users/you/files/sample.pdf
# MANUAL_UPLOAD_FILE_PATH=fixtures/manual-upload/integration-test.txt
# MANUAL_UPLOAD_FILE_PATH=/work/fixtures/manual-upload/integration-test.txt
# MANUAL_UPLOAD_FILE_NAME=sample.pdf
# MANUAL_UPLOAD_CONTENT_TYPE=application/pdf

# --- Optional skips / timeouts ---
# SKIP_CONNECTION_TEST=1
# CONNECTION_TEST_TIMEOUT_SEC=90
# SKIP_ACQUISITION=1
# SKIP_ANALYTICS=1
# SKIP_SEARCH=1
# ACQUISITION_TIMEOUT_SEC=900
# KB_CREATION_TIMEOUT_SEC=1200
