{
  "name": "@nemo/artifact-service",
  "version": "0.1.0",
  "description": "Persistent, version-tracked artifact store for AgentStudio agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp src/openapi.yaml dist/openapi.yaml",
    "start": "NODE_OPTIONS='--require ./node_modules/@agentstudio/observability-client-runtime/dist/preload.js' node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@agentstudio/common": "file:../../common",
    "@agentstudio/observability-client-runtime": "file:../../common/src/observability/observability-client",
    "express": "^4.21.2",
    "isomorphic-git": "^1.27.1",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.20",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "ioredis": "^5.4.1",
    "js-yaml": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/**/__tests__/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
