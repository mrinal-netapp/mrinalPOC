# Keycloak OIDC — off until platform auth is deployed (VITE_AUTH_ENABLED=false).
# To enable: set VITE_AUTH_ENABLED=true and configure issuer/client below.
#   VITE_KEYCLOAK_ISSUER=https://auth.<your-domain>/realms/nemo
#   VITE_KEYCLOAK_CLIENT_ID=agentstudio-gui
#
# Production Keycloak client (agentstudio-gui or agent-studio-ui):
#   Valid redirect URIs must include:
#     https://<ui-host>/auth/callback
#     https://<ui-host>/auth/silent-callback
#     https://<ui-host>/auth/logout-callback
#   Set client attribute post.logout.redirect.uris to "+" (reuses redirect URIs).
#
# Local dev without post-logout URIs in Keycloak:
#   VITE_KEYCLOAK_IDP_SIGNOUT=false
# Optional post-logout override (default: <origin>/auth/logout-callback):
# VITE_KEYCLOAK_POST_LOGOUT_REDIRECT_URI=

VITE_AUTH_ENABLED=false
# VITE_KEYCLOAK_ISSUER=
# VITE_KEYCLOAK_CLIENT_ID=agentstudio-gui

# Local dev: use a relative URL so requests are proxied by Vite (avoids CORS).
# Deployed (Istio gateway): /api/v1 routes straight to config-service (the
# gateway's /api/v1 HTTPRoute needs no rewrite). This matches the agent-studio-ui
# build default in scripts/docker-build.sh. config-service serves under /api/v1
# (there is no /api/v1/config-service path -- that legacy shape only worked
# because the old apigateway/Vite proxy stripped it).
VITE_API_BASE_URL=/api/v1

# Required for local dev proxy (see vite.config.ts).
#
# Direct-backend mode (config-service on localhost):
#   VITE_DEV_PROXY_TARGET=http://localhost:3000
#   VITE_DEV_WORKFLOW_PROXY_TARGET=http://127.0.0.1:8082
#   Vite rewrites /api/v1/config-service → /api/v1 and /config/api/v1 → /api/v1.
#   Membership writes (/workflow/api/v1) proxy to workflow-engine separately.
#
# Gateway mode (project switcher + in-cluster gateway, e.g. app.agentstudio.local):
#   VITE_DEV_PROXY_TARGET=https://app.agentstudio.local:8443
#   VITE_DEV_PROXY_GATEWAY=true
#   VITE_API_BASE_URL=/config/api/v1
#   VITE_AGENT_API_BASE_URL=/agents-maf
#   VITE_AGENT_RUNTIME_API_BASE_URL=/agents-maf
#   Vite forwards /config/*, /agents-maf/*, and /kb/* to the gateway without stripping prefixes.
#   (The gateway rewrites /agents-maf -> /api/v1 at the MAF backend.)
VITE_DEV_PROXY_TARGET=http://localhost:3000
# VITE_DEV_PROXY_GATEWAY=true

VITE_UTILITIES_API_BASE_URL=http://localhost:3400/api/v1/utilities
VITE_AGENT_API_BASE_URL=https://agent-studio-nemo-apim-dev.azure-api.net/v1

# Agents Config Service (config-service: agent + agent-team CRUD).
# Local dev: route through the same-origin Vite proxy (/__config) to avoid CORS.
# A relative path is resolved against the current window origin at runtime, so
# it works on any dev-server port (5173, 5174, …). The proxy forwards to
# VITE_DEV_CONFIG_SERVICE_PROXY_TARGET (defaults to http://localhost:3000).
# Deployed: set to the gateway/APIM base, e.g. https://your-apim.net
VITE_AGENTS_CONFIG_API_BASE_URL=/__config

# Agents Runtime Service (agent-service: invoke / sessions / traces / SSE stream).
# Local dev: route through the same-origin Vite proxy (/__agent_runtime) to
# avoid CORS (the browser blocks direct cross-origin calls to the agent-service).
# A relative path is resolved against the current window origin at runtime, so
# it works on any dev-server port (5173, 5174, …). The proxy forwards to
# VITE_DEV_AGENT_RUNTIME_PROXY_TARGET.
# Deployed: set to the gateway/APIM base or service URL (no proxy needed).
VITE_AGENT_RUNTIME_API_BASE_URL=/__agent_runtime
# Where the /__agent_runtime dev proxy forwards (the real agent-service).
# Defaults to http://localhost:8000 when unset.
VITE_DEV_AGENT_RUNTIME_PROXY_TARGET=http://localhost:8000

# Agents detail feature flags (off by default until sections are production-ready).
# VITE_FEATURE_AGENT_CONFIGURATIONS_TAB=true
# VITE_FEATURE_AGENT_METRICS_ROW=true

# Dev context header (until JWT auth; user_id from token when OIDC is enabled)
VITE_PROJECT_ID=your-project-uuid
VITE_USER_ID=user@example.com
VITE_ORG_ID=your-org-id

# Observability external dashboards
# Grafana — accessible via the grafana-proxy (OIDC-authenticated reverse proxy).
# Local dev: https://grafana.agentstudio.local:8443
# Production: set to the external grafana-proxy hostname.
# VITE_GRAFANA_URL=https://grafana.agentstudio.local:8443

# Phoenix tracing dashboard — accessible via the phoenix subdomain proxy in the gateway.
# Local dev: https://phoenix.agentstudio.local:8443
# Production: set to the external phoenix subdomain hostname.
# VITE_PHOENIX_URL=https://phoenix.agentstudio.local:8443
