{
  "name": "ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed HEAD~1",
    "test:ui": "vitest --ui --coverage",
    "test:filter": "vitest run",
    "test:tag": "sh -c 'if [ -z \"$1\" ]; then echo \"error: tag or regex pattern required\\nUsage: npm run test:tag -- <tag>  (e.g. smoke  or  smoke|router)\" >&2; exit 1; fi; npx vitest run --testNamePattern \"\\\\[tag:($1)\\\\]\"' --",
    "test:ci": "vitest run --coverage --reporter default --reporter verbose --reporter json --reporter junit --outputFile.json=src/utils/unit-tests/test-results/results.json --outputFile.junit=src/utils/unit-tests/test-results/junit.xml",
    "test:kb": "vitest run src/components/knowledge-base/ src/routes/pages/knowledge-base/ src/components/columns/cells/changes-cell.test.tsx src/components/dataset/columns/dataset-snapshot.columns.test.tsx src/components/dataset/utils/dataset.utils.test.ts src/routes/pages/data-management/dataset/detail/dataset-detail-overview.utils.test.tsx src/routes/pages/data-management/data-source/detail/data-source-detail-overview.utils.test.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-form": "^1.28.6",
    "@tanstack/react-table": "^8.21.3",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.55.1",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.13.1",
    "sonner": "^2.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "sass": "^1.83.4",
    "shadcn": "^4.0.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
