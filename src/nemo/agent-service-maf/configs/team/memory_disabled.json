        "description": "Memory test agent — disabled",
        "model": "azure/gpt-4.1-mini",
        "temperature": 0.3,
        "max_tokens": 256,
        "tools": [],
        "mcp_servers": [],
        "function_choice_behavior": "auto"
      }
