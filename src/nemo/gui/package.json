{
  "name": "@agentstudio/gui",
  "version": "1.0.0",
  "description": "Modern GUI for managing namespaces, exploring rays, and S3 explorer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
