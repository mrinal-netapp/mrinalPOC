{
  "name": "@nemo/eval-worker",
  "version": "1.0.0",
  "description": "Temporal worker hosting Agent Evaluation + Agent Test Case workflows",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "watch": "tsc -p tsconfig.app.json --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "trigger-eval": "ts-node scripts/trigger-eval.ts",
    "bundle-workflows": "ts-node scripts/bundle-workflows.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "got": "^11.8.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
