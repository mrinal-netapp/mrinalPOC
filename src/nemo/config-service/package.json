{
  "name": "config-service",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp openapi.yaml dist/openapi.yaml && cp provider-catalog.json dist/provider-catalog.json",
    "start": "NODE_OPTIONS='--require ./node_modules/@agentstudio/observability-client-runtime/dist/preload.js' node dist/index.js",
    "dev": "tsc --watch",
    "test:catalog": "node --require ts-node/register --test tests/referenceCatalog.drift.test.ts",
    "test:ontap": "node --require ts-node/register --test tests/ontap.unit.test.ts",
    "test:anf": "node --require ts-node/register --test tests/anf_mcp.unit.test.ts",
    "test:s3": "node --require ts-node/register --test tests/s3.unit.test.ts tests/s3.dataSource.unit.test.ts tests/s3.dataSet.unit.test.ts tests/s3.routes.unit.test.ts",
    "test:mysql": "node --require ts-node/register --test tests/mysql.unit.test.ts tests/mysql.dataSource.unit.test.ts tests/mysql.dataSet.unit.test.ts tests/mysql.routes.unit.test.ts",
    "test:kb": "node --require ts-node/register --test tests/knowledgeBase.unit.test.ts",
    "test:eval": "node --require ts-node/register --test tests/evaluation.unit.test.ts",
    "test:kb:coverage": "c8 --reporter=text --reporter=html --reporter=json-summary --report-dir=coverage/kb --include='validators/knowledgeBaseValidator.ts' --include='routes/knowledgeBaseRoutes.ts' --include='models/KnowledgeBase.ts' --include='services/KnowledgeBaseScheduleService.ts' --include='services/KnowledgeBaseIdGenerator.ts' --include='utils/cronFromKBSync.ts' node --require ts-node/register --test tests/knowledgeBase.unit.test.ts",
    "test:postgresql": "node --require ts-node/register --test tests/postgresql.unit.test.ts tests/postgresql.dataSource.unit.test.ts tests/postgresql.dataSet.unit.test.ts tests/postgresql.routes.unit.test.ts",
    "test:volume": "node --require ts-node/register --test tests/volume.unit.test.ts tests/volume.dataSource.unit.test.ts tests/volume.dataSet.unit.test.ts tests/volume.nfsExport.unit.test.ts tests/volume.routes.unit.test.ts",
    "test:http-status": "node --require ts-node/register --test tests/resolveHttpStatusCode.unit.test.ts",
    "test:scan": "node --require ts-node/register --test tests/datasource.scan.unit.test.ts",
    "test:project-membership": "node --require ts-node/register --test tests/projectMembership.unit.test.ts",
    "test": "node --require ts-node/register --test tests/*.test.ts",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' c8 sh -c 'node --require ts-node/register --test tests/*.test.ts'"
  },
  "dependencies": {
    "@agentstudio/common": "file:../../common",
    "@agentstudio/observability-client-runtime": "file:../../common/src/observability/observability-client",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "@kubernetes/client-node": "^1.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@types/js-yaml": "^4.0.5",
    "ajv": "^8.20.0",
    "axios": "^1.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-validator": "7.3.0",
    "js-yaml": "^4.1.0",
    "path": "^0.12.7",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "swagger-ui-express": "^5.0.0",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.1"
  },
  "overrides": {
    "glob": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "c8": "^10.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
