# OS / editor cruft -------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
.claude/
*.iml
*.code-workspace

# Local-only Python deps installed for `make -n` validation of the env bridge
# (deployments/_lib/env_yaml.py needs PyYAML). Never committed.
.tmp-pylib/

# Helm caches (Makefile redirects HELM_CACHE_HOME / HELM_CONFIG_HOME /
# HELM_DATA_HOME at repo-root-scoped paths to keep them out of chart
# directories — see the `helm-deps-update` macro and the policy comment
# above it).
/.helm-cache/
/.helm-config/
/.helm-data/
# Pre-existing fallback caches (in case helm wrote them inside the
# repo root or a chart dir on an earlier run).
**/.cache/helm/
**/.config/helm/

# Node.js / TypeScript ----------------------------------------------------
# dist/ is rebuilt inside every Dockerfile via `npm run build`; tracking it
# adds tens of thousands of files for no benefit.
**/node_modules/
**/dist/
**/.next/
**/.nuxt/
**/.vite/
**/.parcel-cache/
**/.turbo/
**/build/
**/coverage/
**/.eslintcache
**/*.tsbuildinfo
**/.cache/
**/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.pytest_deps/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
.hypothesis/
.venv/
venv/
env/
ENV/
.eggs/
*.egg
*.egg-info/

# Rust --------------------------------------------------------------------
**/target/
**/*.rs.bk
**/Cargo.lock.bak
.cargo-home/
.tools/

# Go ----------------------------------------------------------------------
*.test
*.out

# Helm --------------------------------------------------------------------
# *.tgz files are regenerated by `helm dependency update`, which the
# Makefile runs as part of each tier upgrade target before every deploy.
# Chart.lock pins versions and IS tracked.
**/charts/*.tgz

# Exception: the platform tier VENDORS its remote chart deps (redis,
# lakekeeper) and skips dep-update at deploy time via
# platform/.helm-skip-dep-update. Committing these .tgz removes the
# per-deploy pull from charts.bitnami.com / Docker Hub OCI, which was
# rate-limiting (429) AKS+GKE deploys. Refresh with `make vendor-platform-deps`.
!deployments/helm/platform/charts/redis-*.tgz
!deployments/helm/platform/charts/lakekeeper-*.tgz

# Exception: database tier vendors its postgresql dep (see .helm-skip-dep-update).
!deployments/helm/database/charts/postgresql-*.tgz

# Local env / secrets ----------------------------------------------------
.env
.env.local
.env.*.local
*.env
!example.env
!*.env.example

# Logs / temp -----------------------------------------------------------
*.log
*.pid
*.tmp
*.bak
*.orig
**/logs/
**/tmp/
# Observability trace/app JSONL (written by configure_observability_minimal during local runs/tests)
**/Trace_Logs/
**/App_Logs/

# Auth design docs (kept local only)
docs/auth/

# Generated workers build context (synced by make workers-build, not for remote)
src/nemo/workers/observability-client/

# Runtime logs from apigateway-service
src/nemo/apigateway-service/proxy/App_Logs/
src/nemo/apigateway-service/proxy/Trace_Logs/

.cursor/
