{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Static public IP for the Istio/Gateway LoadBalancer. Reference in deployments/helm/edge/values-aks.yaml via azure-pip-name annotation."
  },
  "parameters": {
    "pipName": {
      "type": "string",
      "metadata": {
        "description": "Name of the public IP resource (e.g. pip-agentstudio-gw-preprod-eus2-001)."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sku": {
      "type": "string",
      "defaultValue": "Standard",
      "allowedValues": [
        "Basic",
        "Standard"
      ]
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/publicIPAddresses",
      "apiVersion": "2023-11-01",
      "name": "[parameters('pipName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "properties": {
        "publicIPAllocationMethod": "Static",
        "publicIPAddressVersion": "IPv4"
      }
    }
  ],
  "outputs": {
    "pipName": {
      "type": "string",
      "value": "[parameters('pipName')]"
    },
    "ipAddress": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Network/publicIPAddresses', parameters('pipName')), '2023-11-01').ipAddress]"
    },
    "resourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/publicIPAddresses', parameters('pipName'))]"
    }
  }
}
