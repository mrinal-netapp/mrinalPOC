{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "RBAC-enabled Azure Key Vault for AgentStudio Workload Identity secrets."
  },
  "parameters": {
    "keyVaultName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Globally unique Key Vault name (3-24 chars, alphanumeric and hyphens only). Example: kv-agentstudio-dev-eus2-001"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region; defaults to the resource group location."
      }
    },
    "tenantId": {
      "type": "string",
      "metadata": {
        "description": "Entra ID tenant ID. Run: az account show --query tenantId -o tsv"
      }
    },
    "purgeProtectionEnabled": {
      "type": "bool",
      "metadata": {
        "description": "Set true for production vaults. False keeps dev iteration fast."
      }
    },
    "softDeleteRetentionInDays": {
      "type": "int",
      "minValue": 7,
      "maxValue": 90,
      "metadata": {
        "description": "Soft-delete retention period. Minimum 7 days; use 90 for production."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.KeyVault/vaults",
      "apiVersion": "2023-07-01",
      "name": "[parameters('keyVaultName')]",
      "location": "[parameters('location')]",
      "properties": {
        "tenantId": "[parameters('tenantId')]",
        "sku": {
          "family": "A",
          "name": "standard"
        },
        "enableRbacAuthorization": true,
        "enabledForDeployment": false,
        "enabledForDiskEncryption": false,
        "enabledForTemplateDeployment": false,
        "enableSoftDelete": true,
        "softDeleteRetentionInDays": "[parameters('softDeleteRetentionInDays')]",
        "enablePurgeProtection": "[if(parameters('purgeProtectionEnabled'), true(), null())]",
        "publicNetworkAccess": "Enabled"
      }
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[parameters('keyVaultName')]"
    },
    "keyVaultUri": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName')), '2023-07-01').vaultUri]"
    },
    "keyVaultResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]"
    }
  }
}
