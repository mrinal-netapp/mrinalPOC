{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Grant AcrPull on a shared Container Registry to the AKS kubelet managed identity."
  },
  "parameters": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the AKS kubelet managed identity."
      }
    },
    "registryResourceId": {
      "type": "string",
      "metadata": {
        "description": "Full resource ID of the shared ACR (scope for AcrPull)."
      }
    }
  },
  "variables": {
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d",
    "acrPullRoleDefinitionId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Authorization/roleDefinitions/', variables('acrPullRoleId'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(parameters('registryResourceId'), parameters('principalId'), 'AcrPull')]",
      "scope": "[parameters('registryResourceId')]",
      "properties": {
        "roleDefinitionId": "[variables('acrPullRoleDefinitionId')]",
        "principalId": "[parameters('principalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}
