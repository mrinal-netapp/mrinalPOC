# Copy to a local file (e.g. ~/agentstudio-aws-secrets.env), fill in values, then:
#   set -a && source ~/agentstudio-aws-secrets.env && set +a
#   make deploy-eks ENDPOINT=... CONTAINER_IMAGE_REPO=... IMAGE_TAG=...
#
# POSTGRES_PASSWORD must match the shared PostgreSQL password used by the
# database tier (default in values.yaml: agentstudio-postgres-password).
#
# Do not commit files containing real secrets.
#
# ─── Microsoft Entra broker (EKS workforce SSO) ───────────────────────────
# App: agent-studio-dev-eks-broker (separate from AKS broker app; same tenant).
export KEYCLOAK_ENTRA_APP_CLIENT_ID='change-me-eks-entra-app-client-id'
export KEYCLOAK_TENANT_ID='change-me-entra-tenant-id'
export KEYCLOAK_ENTRA_GROUP_ADMINS_OBJECTID='change-me-admins-group-oid'
export KEYCLOAK_ENTRA_GROUP_MEMBERS_OBJECTID='change-me-members-group-oid'
# Entra broker client secret: create the K8s Secret once (NOT via this file in CI):
#   KEYCLOAK_ENTRA_CLIENT_SECRET='<secret>' make eks-keycloak-broker-secret

export KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD='change-me-bootstrap-admin'
export POSTGRES_PASSWORD='change-me-postgres'

export KEYCLOAK_OIDC_SECRET_GATEWAY='change-me-gateway'
export KEYCLOAK_OIDC_SECRET_LAKEKEEPER='change-me-lakekeeper'
export KEYCLOAK_OIDC_SECRET_WORKFLOW_ENGINE='change-me-workflow-engine'
export KEYCLOAK_OIDC_SECRET_ANALYTICS_ENGINE='change-me-analytics-engine'
export KEYCLOAK_OIDC_SECRET_CONFIG_SERVICE='change-me-config-service'
export KEYCLOAK_OIDC_SECRET_STORAGE_MANAGER='change-me-storage-manager'
export KEYCLOAK_OIDC_SECRET_AGENT_SERVICE='change-me-agent-service'
export KEYCLOAK_OIDC_SECRET_CONNECTOR_WORKER='change-me-connector-worker'
export KEYCLOAK_OIDC_SECRET_ARTIFACT_SERVICE='change-me-artifact-service'
