# Patterns excluded from `helm package` AND from the in-cluster release
# Secret that `helm upgrade` stores. Without these, the runner workspace
# accumulates stale subchart .tgz files / unpacked subchart dirs / IDE
# crud across runs and helm packs all of it into the release Secret,
# which can blow past the kube-apiserver 3 MiB request limit.
#
# Note: the kube-prometheus-stack subchart (huge, with CRDs) ships its
# own .helmignore inside the .tgz, so this file only needs to cover
# the parent chart layer.
.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Editor / OS scratch
*.swp
*.bak
*.tmp
*.orig
*~
.project
.idea/
*.tmproj
.vscode/
# Local-dev caches that can wander into a workspace
__pycache__/
*.pyc
.venv/
node_modules/
# Helm's own caches if it ever falls back to writing them in CWD.
# See database/.helmignore for the full explanation; tl;dr: the
# kube-prometheus-stack index alone is large and will blow past the
# apiserver's 3 MiB request limit if packed into the release Secret.
.cache/
.config/
.helm/
# Note: `*.bak` above already covers `charts/<anything>.tgz.bak`.
# Stale outdated subchart .tgz files are scrubbed by the Makefile's
# `helm-deps-update` macro before every `helm dependency update`.
