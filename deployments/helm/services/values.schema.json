{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentStudio services tier values",
  "description": "Helm JSON schema for deployments/helm/services. Validates umbrella-level keys at helm install/upgrade time.",
  "type": "object",
  "additionalProperties": true,

  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "storageClass": {
          "type": "string",
          "description": "StorageClass for default-bucket PVC. Cloud-specific (anf-nfs / gcnv-nas-rwx / fsxn-nas). Empty string falls back to cluster default."
        },
        "endpoint": {
          "type": "string",
          "description": "Public hostname for this deployment (e.g. agentstudio.dev.openeng.netapp.com). Used by URL helpers in _helpers.tpl."
        },
        "gatewayHttpsPort": {
          "type": ["string", "integer"],
          "description": "Public HTTPS port. 443 for cloud; 8443 for local KIND clusters that cannot bind privileged ports."
        },
        "imageRepository": {
          "type": "string",
          "description": "Base image repository prefix (e.g. docker.repo.eng.netapp.com/user/rp29322)."
        },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["", "Always", "IfNotPresent", "Never"],
          "description": "Global image pull policy override. Empty string leaves each chart's image.pullPolicy in effect."
        },
        "deploymentName": {
          "type": "string"
        },
        "lakekeeperCatalogUrl": {
          "type": "string"
        },
        "observability": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "otlpEndpoint": {
              "type": "string",
              "description": "OTLP HTTP collector endpoint. Set to empty string to suppress OTLP env vars."
            }
          }
        }
      }
    },

    "defaultBucketPvc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "create": {
          "type": "boolean",
          "description": "Create the default-bucket PVC in the services namespace. Required true on every cloud environment."
        },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"],
          "description": "PVC access mode. Cloud deployments with ANF/Filestore/FSx must use ReadWriteMany."
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi|Ti|Pi|Ei|K|M|G|T|P|E)?$",
          "description": "PVC storage request size (e.g. 10Gi, 1Ti)."
        },
        "storageClass": {
          "type": "string",
          "description": "StorageClass for the PVC. Defaults to global.storageClass when empty."
        },
        "volumeName": {
          "type": "string",
          "description": "Static PV name to bind to. Leave empty for dynamic provisioning."
        },
        "shareFromPVC": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": { "type": "string" },
            "name": { "type": "string" }
          }
        }
      }
    },

    "crossNsServices": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["externalName", "serviceEntry"],
          "description": "Cross-namespace service aliasing mode. externalName (default) works without Istio DNS capture."
        }
      }
    },

    "keycloak": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "authSubdomain": {
          "type": "string"
        },
        "setup": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "keycloakNamespace": { "type": "string" },
            "keycloakUrl": { "type": "string" }
          }
        }
      }
    },

    "agent-service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "create": { "type": "boolean" },
            "azureClientId": { "type": "string" }
          }
        },
        "workloadIdentity": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        }
      }
    },

    "config-service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "host": { "type": "string" },
            "port": { "type": ["string", "integer"] },
            "name": { "type": "string" },
            "user": { "type": "string" },
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },

    "workflow-engine": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": {
          "type": "string",
          "description": "Temporal namespace. local overlay overrides to agentstudio-platform for FQDN cross-namespace routing."
        },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    },

    "artifact-service": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "database": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string" }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
